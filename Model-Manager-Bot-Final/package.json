{
  "name": "model-manager-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Bot Discord para cadastro e gerenciamento de modelos (Supabase, AES-256-GCM).",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "commands:deploy": "node src/deploy-commands.js",
    "check": "node scripts/check.js",
    "lint": "eslint .",
    "test": "node --test",
    "audit:deps": "npm audit --omit=dev",
    "validate": "npm run check && npm run lint && npm test && npm run audit:deps"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0"
  }
}
